# Public project URL and publishable (or legacy anon) key. Never use service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Self-hosting config is generated by npm run supabase:start (no manual keys required):
# NEXT_PUBLIC_SUPABASE_PROXY_PATH=/supabase
# NEXT_PUBLIC_SUPABASE_AUTH_MODE=password
# FOODLAB_SUPABASE_AUTH_URL=http://127.0.0.1:54331
# FOODLAB_SUPABASE_REST_URL=http://127.0.0.1:54332
